<?xml version='1.0' encoding='utf-8'?>
<widget id="org.aston.lampa" version="3.3.3" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Lampa</name>
    <description>
        一个TMDB android TV 客户端，可以查看热门影片及电视剧、搜索种子并进行在线观看。
    </description>
    <author email="astonhe@gmail.com" href="">
        Aston
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <allow-intent href="magnet:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- 最低支持 Android 5.0 (API 21)，保证 Android 6 电视盒子顺利安装 -->
        <preference name="android-minSdkVersion" value="21" />
        <preference name="android-targetSdkVersion" value="29" />

        <!-- 让程序判断是不是android平台 -->
        <preference name="OverrideUserAgent" value="lampa_client (Dalvik)" />
        
        <!-- 回退到使用文件而不是https://localhost 不然插件不能正常工作 -->
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="Fullscreen" value="true" />
        
        <!-- 隐藏顶部状态栏 -->
        <preference name="StatusBarOverlaysWebView" value="true" />
        <preference name="StatusBarBackgroundColor" value="#00000000" />

        <!-- 开屏闪屏配置
        <preference name="SplashScreen" value="screen" />
        <preference name="SplashScreenDelay" value="1000" />
        <preference name="FadeSplashScreen" value="false" />
        <preference name="ShowSplashScreenSpinner" value="false" />
        <preference name="AutoHideSplashScreen" value="false" />
         -->

        <!-- 1. Cordova 核心自带底色（不需要任何插件，直接把根布局变纯黑） -->
        <!-- 锁定安卓系统创建窗口瞬间为纯黑 #000，与 .welcome 的纯黑完全一致 -->
        <preference name="BackgroundColor" value="0x001d1f20" />
        
        
        <icon density="mdpi" src="res/icons/android/mipmap-mdpi/ic_launcher.png" />
        <icon density="hdpi" src="res/icons/android/mipmap-hdpi/ic_launcher.png" />
        <icon density="xhdpi" src="res/icons/android/mipmap-xhdpi/ic_launcher.png" />
        <icon density="xxhdpi" src="res/icons/android/mipmap-xxhdpi/ic_launcher.png" />
        <icon density="xxxhdpi" src="res/icons/android/mipmap-xxxhdpi/ic_launcher.png" />

        <!-- 强制开启硬件加速，让 GPU 分担海报墙渲染压力，减少 CPU 占用 -->
        <preference name="android-hardwareAccelerated" value="true" />
        
        <!-- 允许 WebView 访问应用私有文件，避免多余的跨域读写缓存 -->
        <preference name="AllowUntrustedCerts" value="true" />
        
        <!-- ================= Android TV 电视专属配置 ================= -->
        <!-- 1. 声明支持电视（设置 required="false" 可以让手机和平板也能正常安装） -->
        <uses-feature android:name="android.software.leanback" android:required="false" />
        <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

        <!-- 2. 将仓库里的 banner.png 自动拷贝到 Android 平台的 drawable 资源目录 -->
        <resource-file src="res/banner.png" target="app/src/main/res/drawable/banner.png" />

        <!-- 3. 将 banner 挂载到应用，并添加 LEANBACK 电视桌面启动器入口 -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <meta-data android:name="isAndroidTV" android:value="true" />
        </config-file>
        
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity[@android:name='MainActivity']">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </config-file>

        <!-- 解决 Android 8.0+ 唤起应用内部更新被系统拦截的问题 -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
        </config-file>

        <!-- 关联图标与横幅 -->
        <preference name="AndroidTVBanner" value="res/banner.png" />
    </platform>
</widget>
